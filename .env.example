# Fase 4 — observabilidad de bots. Sin estas variables, el sitio funciona
# igual mostrando el sitio pero /admin/visitas queda inaccesible (401) y no se
# registra ninguna visita (fallo seguro, no un error).

# Basic Auth para /admin/visitas y /api/admin/visitas
ADMIN_USER=
ADMIN_PASSWORD=

# Upstash Redis (REST), para el log de visitas y el rate limiting del MCP (Fase 5)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional, solo para "npm run indexnow"
# SITE_URL=https://lacasucademio.vercel.app
